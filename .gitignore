# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Play intermediate screenshots (keep finished assets/google_play/screenshot_phone_*.png)
assets/google_play/raw_en/

# Local Play upload helper may reference machine paths; keep listings/csv/assets
# Signing secrets stay under android/.gitignore (key.properties, *.jks)
/dist/
android/key.properties
android/*.jks
android/*.keystore
.play-service-account.json
**/play-service-account.json
secrets/
*.pem
*.p12
.env
.env.*
